{
  "name": "InferenceRuns",
  "type": "object",
  "properties": {
    "client_profile_id": {
      "type": "string"
    },
    "interaction_id": {
      "type": "string"
    },
    "aci": {
      "type": "number"
    },
    "aci_delta": {
      "type": "number"
    },
    "top_action_level_1": {
      "type": "number"
    },
    "top_action_level_2": {
      "type": "number"
    },
    "coach_reflection_text": {
      "type": "string"
    },
    "action_pct": {
      "type": "object"
    },
    "thought_pct": {
      "type": "object"
    },
    "primary_level": {
      "type": "number"
    },
    "drift_patterns": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "gap_analysis": {
      "type": "object"
    },
    "gap_companion": {
      "type": "object"
    },
    "alignment_momentum_score": {
      "type": "number",
      "description": "Alignment Momentum Score (AMS)"
    },
    "alignment_momentum_direction": {
      "type": "string",
      "enum": [
        "improving",
        "declining",
        "stable",
        "emerging"
      ],
      "description": "Direction of alignment momentum"
    },
    "alignment_momentum_summary": {
      "type": "string",
      "description": "Human-readable summary of alignment momentum"
    },
    "alignment_trend_4wk": {
      "type": "number",
      "description": "Latest alignment score minus oldest alignment score across the 4-week window. Positive = improving."
    },
    "gap_trend_4wk": {
      "type": "number",
      "description": "Oldest absolute Thought vs Action gap minus latest. Positive = gap shrinking = good."
    }
  },
  "required": [
    "client_profile_id"
  ]
}